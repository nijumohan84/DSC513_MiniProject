labs(x="CO2 Concentration (ppm)") +
theme_light() +
scale_y_continuous(name = "Mean Rate of Change in CO2 Uptake",
sec.axis = sec_axis(~./10, name = "Standard Deviation of Rate of change")) +
theme(legend.position = "bottom",
plot.title = element_text(hjust = 0.5, size = 18),
strip.background = element_rect(fill="white"),
strip.text = element_text(size=15, colour="black")) +
ggtitle(expression(bold("Mean and Standard Deviation of CO2")))
library(forcats)
library(ggplot2)
library(tidyr)
library(dplyr)
library(stringr)
data(CO2)
rateOfChange <- CO2 %>% mutate(roc = ifelse((Plant == lag(Plant)), ((uptake-lag(uptake))/1)*1, NA)) %>% drop_na()
rateOfChange
#rateOfChange[1, ]$roc = CO2[1, ]$uptake
rocSummary <- rateOfChange %>% group_by(conc, Type, Treatment) %>%
summarize(meanRoc = mean(roc), sdroc = sd(roc))
ggplot(rocSummary,aes(x=conc)) +
geom_line( aes(y=meanRoc),
color="#FF6348",
linewidth = 1.5) +
geom_line( aes(y=sdroc), color="#4682B4", linetype="dashed", linewidth = 1.5) +
facet_wrap(~Type, nrow =  1) +
labs(x="CO2 Concentration (ppm)") +
theme_light() +
scale_y_continuous(name = "Mean Rate of Change in CO2 Uptake",
sec.axis = sec_axis(~./10, name = "Standard Deviation of Rate of change")) +
theme(legend.position = "bottom",
plot.title = element_text(hjust = 0.5, size = 18),
strip.background = element_rect(fill="white"),
strip.text = element_text(size=15, colour="black")) +
ggtitle(expression(bold("Mean and Standard Deviation of CO2"))) +
ylim(0,70)
